rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // 1. GLOBAL SAFETY NET
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // 2. GLOBAL PRIMITIVES & HELPERS
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // For prototype: any authenticated user is an admin.
      // In production, uncomment the next line to restrict access.
      // return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      return isSignedIn();
    }
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // -------------------------------------------------------------------------
    // 3. VALIDATION BLUEPRINTS
    // -------------------------------------------------------------------------
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'category_id', 'isActive'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.price is number
        && data.category_id is string && data.category_id.size() > 0 && data.category_id.size() <= 128
        && data.isActive is bool
        && data.get('description', '') is string && data.get('description', '').size() <= 500
        && data.get('image_url', '') is string && data.get('image_url', '').size() <= 1024
        && data.get('customizations', []) is list && data.get('customizations', []).size() <= 20
        && data.get('createdAt', '') is string && data.get('createdAt', '').size() <= 50
        && data.get('updatedAt', '') is string && data.get('updatedAt', '').size() <= 50;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'order', 'isActive'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 50
        && data.order is number
        && data.isActive is bool;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['orderId', 'userId', 'customerName', 'customerPhone', 'items', 'totalAmount', 'paymentMethod', 'paymentStatus', 'orderStatus', 'orderType'])
        && data.orderId is string && data.orderId.size() > 0 && data.orderId.size() <= 100
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 100
        && data.get('customerEmail', '') is string && data.get('customerEmail', '').size() <= 200
        && data.customerPhone is string && data.customerPhone.size() > 0 && data.customerPhone.size() <= 20
        && data.items is list && data.items.size() > 0 && data.items.size() <= 50
        && data.totalAmount is number && data.totalAmount >= 0
        && data.paymentMethod is string && data.paymentMethod.size() > 0 && data.paymentMethod.size() <= 50
        && data.paymentStatus is string && data.paymentStatus.size() > 0 && data.paymentStatus.size() <= 50
        && data.orderStatus is string && data.orderStatus.size() > 0 && data.orderStatus.size() <= 50
        && data.orderType is string && data.orderType.size() > 0 && data.orderType.size() <= 50
        && data.get('address', '') is string && data.get('address', '').size() <= 500
        && data.get('notes', '') is string && data.get('notes', '').size() <= 500
        && data.get('paymentReference', '') is string && data.get('paymentReference', '').size() <= 100
        && data.get('createdAt', '') is string && data.get('createdAt', '').size() <= 50
        && data.get('updatedAt', '') is string && data.get('updatedAt', '').size() <= 50;
    }

    function isValidSetting(data) {
      return data.keys().hasAll(['webhookUrl'])
        && data.get('webhookUrl', '') is string && data.get('webhookUrl', '').size() <= 1024
        && data.get('gcashQrUrl', '') is string && data.get('gcashQrUrl', '').size() <= 1024
        && data.get('gcashNumber', '') is string && data.get('gcashNumber', '').size() <= 50;
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['role'])
        && data.role is string && data.role.size() > 0 && data.role.size() <= 20;
    }

    // -------------------------------------------------------------------------
    // 4. COLLECTION RULES
    // -------------------------------------------------------------------------

    match /admins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Bootstrapped admin (first admin creation or superadmin). Let's restrict write to admins only.
      // But we need a way to bootstrap. In this case, we won't allow client writes, only via console.
      allow write: if false; 
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow delete: if isAdmin() && isValidId(productId);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(categoryId) && isValidCategory(incoming());
      allow update: if isAdmin() && isValidId(categoryId) && isValidCategory(incoming());
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    match /orders/{orderId} {
      // Users can read their own orders; admins can read all orders
      allow get: if isValidId(orderId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      // Creating an order requires the user to own it
      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming()) 
                    && incoming().userId == request.auth.uid;
      
      // Updating an order:
      // Admins can update anything.
      // Users can only update `paymentReference` and `paymentStatus` (to 'For Verification') if it's pending.
      allow update: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming()) && (
        isAdmin() || 
        (
          incoming().userId == request.auth.uid 
          && existing().userId == request.auth.uid
          && existing().paymentStatus == 'Pending'
          && incoming().paymentStatus == 'For Verification'
          && incoming().diff(existing()).affectedKeys().hasOnly(['paymentReference', 'paymentStatus', 'updatedAt'])
        )
      );
      
      allow delete: if isAdmin() && isValidId(orderId);
    }

    match /settings/{settingId} {
      allow read: if true; // Public settings like gcashQrUrl
      allow create: if isAdmin() && isValidId(settingId) && isValidSetting(incoming());
      allow update: if isAdmin() && isValidId(settingId) && isValidSetting(incoming());
      allow delete: if false; // Settings shouldn't be deleted, just updated
    }
  }
}
